{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /admin* {
		reverse_proxy api:8000
	}

	@hiddenMedia path_regexp hidden (^|/)\.
	handle @hiddenMedia {
		respond 404
	}

	header /media/* X-Content-Type-Options "nosniff"
	handle_path /media/* {
		root * /srv/media
		file_server {
			hide .*
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
