{
  "components": {
    "schemas": {
      "Availability": {
        "description": "Availability states understood by every delivery channel.",
        "enum": [
          "available",
          "reserved"
        ],
        "title": "Availability",
        "type": "string"
      },
      "CoordinatesResponse": {
        "additionalProperties": false,
        "description": "WGS84 coordinates exposed by the API.",
        "properties": {
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "CoordinatesResponse",
        "type": "object"
      },
      "EstateResponse": {
        "additionalProperties": false,
        "description": "Public representation of one synthetic estate.",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/Availability"
          },
          "availability_label_key": {
            "title": "Availability Label Key",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "location": {
            "$ref": "#/components/schemas/CoordinatesResponse"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "location",
          "availability",
          "availability_label_key"
        ],
        "title": "EstateResponse",
        "type": "object"
      },
      "EstatesResponse": {
        "additionalProperties": false,
        "description": "Public list-estates response envelope.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EstateResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "EstatesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Machine-readable health response.",
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "WEF synthetic backend proof",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/estates": {
      "get": {
        "description": "Run the application query obtained from explicit app state.",
        "operationId": "listEstates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstatesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List synthetic estates",
        "tags": [
          "estates"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Report that the event loop can serve requests.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Report readiness only when the composed database check succeeds.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "summary": "Check database readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
