{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contract:check": "openapi-typescript ../../contracts/openapi/v1.json --output src/generated/api.ts --alphabetize --check",
    "contract:docs": "mkdir -p ../../tmp && redocly build-docs ../../contracts/openapi/v1.json --output ../../tmp/openapi-v1.html --disableGoogleFont",
    "contract:generate": "openapi-typescript ../../contracts/openapi/v1.json --output src/generated/api.ts --alphabetize",
    "contract:lint": "redocly lint ../../contracts/openapi/v1.json",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text",
    "test:e2e": "node ./scripts/prepare-standalone-e2e.mjs && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.101.4",
    "maplibre-gl": "^6.4.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.71.2",
    "react-map-gl": "^8.1.2",
    "web-vitals": "^6.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "^2.46.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
