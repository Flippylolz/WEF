{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contract:check": "openapi-typescript ../../contracts/openapi/v1.json --output src/generated/api.ts --alphabetize --check",
    "contract:docs": "mkdir -p ../../tmp && redocly build-docs ../../contracts/openapi/v1.json --output ../../tmp/openapi-v1.html --disableGoogleFont",
    "contract:generate": "openapi-typescript ../../contracts/openapi/v1.json --output src/generated/api.ts --alphabetize",
    "contract:lint": "redocly lint ../../contracts/openapi/v1.json",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
